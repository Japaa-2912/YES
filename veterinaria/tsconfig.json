{
  "compilerOptions": {
    "target": "ES2019",
    "module": "es2015",
    "lib": ["ES2019", "DOM"],
    "strict": true,
    "noUnusedLocals": true,
    "noImplicitReturns": true,
    "outDir": "assets/js",
    "rootDir": "src",
    "removeComments": false,
    "sourceMap": false
  },
  "include": ["src/**/*.ts"]
}
